<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

  <!-- base_link (каркаc машины) params -->
  <xacro:property name="base_length" value="1.05"/>
  <xacro:property name="base_width" value="0.52"/>
  <xacro:property name="base_height" value="0.22"/>

  <xacro:property name="base_mass" value="12.0" />

  <!-- моменты инерции (сопротивление ВОКРУГ заданной оси) (>0) -->
  <!-- 
    точный коэффициент пропорциональности между приложенным моментом силы и resulting угловым ускорением.
    ixx = ∫ρ(y^2+z^2)dV, ρ*dV = mass (мин.часть) 
   -->
  <xacro:property name="base_ixx" value="0.55" />
  <xacro:property name="base_iyy" value="1.10" />
  <xacro:property name="base_izz" value="1.40" />

  <!-- ixy, ixz, iyz - центробежные моменты (не ограниен)-->
  <!-- 
    мера асимметрии распределения массы относительно осей координат:
    ixy = −∫ρ⋅x⋅ydV
    =0, при условии симметрии объекта
  -->

  <!-- каркас машины -->
  <link name="base_link">

    <!-- визуал -->
    <visual>
      <!-- координаты base_link -->
      <origin xyz="0 0 ${base_height / 2.0}" rpy="0.0 0.0 0.0"/>

      <!-- размерность каркаса -->
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <!-- материал и цвет -->
      <material name="base_blue">
        <color rgba="0.05 0.36 0.72 1.0"/>  
      </material>
    </visual>

    <!-- коллизии (bbox) -->
    <collision>
      <origin xyz="0 0 ${base_height / 2.0}" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <!-- инерция (физика объекта) -->
    <inertial>
      <!-- <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/> -->
      <mass value="${base_mass}"/>
      <inertia
        ixx="${base_ixx}"
        ixy="0.0"
        ixz="0.0"
        iyy="${base_iyy}"
        iyz="0.0"
        izz="${base_izz}"
      />
    </inertial>
  </link>

  <!-- lidar_link (лидар) params-->
  <xacro:property name="lidar_x" value="0.28" />
  <xacro:property name="lidar_z" value="0.38" />
  <xacro:property name="lidar_r" value="0.06" />
  <xacro:property name="lidar_l" value="0.1" />

  <!-- lidar_link -->
  <link name="lidar_link">
    <visual>
      <geometry>
       <cylinder radius="${lidar_r}" length="${lidar_l}"/> 
      </geometry>
      <material name="lidar_red">
        <color rgba="1.0 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
       <cylinder radius="${lidar_r}" length="${lidar_l}"/> 
      </geometry>       
    </collision>
    <inertial>
        <mass value="0.033"/>
        <inertia
          ixx="0.0003"
          ixy="0"
          ixz="0"
          iyy="0.0003"
          iyz="0"
          izz="0.0003"
        />
    </inertial>
  </link>

  <!-- base + lidar-->
  <joint name="lidar_join" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x} 0.0 ${lidar_z}" rpy="0.0 0.0 0.0"/>
  </joint>

  <!-- imu_link (инерциальный измерительный модуль) params -->
  <xacro:property name="imu_size" value="0.05" />

  <!-- imu_link -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="${imu_size} ${imu_size} ${imu_size * 0.4}" />
      </geometry>
      <material name="imu_orange">
        <color rgba="1.0 0.5 0.0 1.0" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${imu_size} ${imu_size} ${imu_size * 0.4}" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.033" />
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003" />
    </inertial>
  </link>

  <!-- base + imu -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="${lidar_x} 0 ${lidar_z - 0.1}" rpy="0 0 0" />
  </joint>

  <!-- wheel_link (колесо) params -->
  <xacro:property name="wheel_radius" value="0.12" />
  <xacro:property name="wheel_width" value="0.07" />
  <xacro:property name="wheel_mass" value="0.8" />
  <xacro:property name="wheel_ixx" value="0.006" />
  <xacro:property name="wheel_iyy" value="0.003" />
  <xacro:property name="wheel_izz" value="0.006" />

  <!-- wheel_macro -->
  <xacro:macro name="wheel" params="prefix parent x y z_offset">
    <link name="${prefix}_wheel">
      <visual>
        <!-- Колесо лежит на боку, поэтому поворачиваем геометрию -->
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
        <material name="wheel_dark">
          <color rgba="0.1 0.1 0.1 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}" />
        <inertia ixx="${wheel_ixx}" ixy="0" ixz="0" iyy="${wheel_iyy}" iyz="0" izz="${wheel_izz}" />
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${parent}" />
      <child link="${prefix}_wheel" />
      <!-- Сдвигаем колесо вниз от центра корпуса на радиус + зазор -->
      <origin xyz="${x} ${y} ${z_offset}" rpy="0 0 0" />
      <!-- Ось вращения - ось Y локальной системы колеса -->
      <axis xyz="0 1 0" />
    </joint>
  </xacro:macro>

  <!-- передние колеса -->
  <xacro:wheel prefix="front_left" parent="base_link" x="0.4" y="0.31" z_offset="-0.1" />
  <xacro:wheel prefix="front_right" parent="base_link" x="0.4" y="-0.31" z_offset="-0.1" />
  <!-- задние колеса -->
  <xacro:wheel prefix="rear_left" parent="base_link" x="-0.4" y="0.31" z_offset="-0.1" />
  <xacro:wheel prefix="rear_right" parent="base_link" x="-0.4" y="-0.31" z_offset="-0.1" />

  
</robot>