<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

  <!-- base_link (каркас машины) params -->
  <xacro:property name="base_length" value="1.05"/>
  <xacro:property name="base_width" value="0.52"/>
  <xacro:property name="base_height" value="0.22"/>

  <xacro:property name="base_mass" value="12.0" />

  <!-- моменты инерции (сопротивление ВОКРУГ заданной оси) (>0) -->
  <!-- 
    точный коэффициент пропорциональности между приложенным моментом силы и resulting угловым ускорением.
    ixx = ∫ρ(y^2+z^2)dV, ρ*dV = mass (мин.часть) 
  -->
  <xacro:property name="base_ixx" value="0.55" />
  <xacro:property name="base_iyy" value="1.10" />
  <xacro:property name="base_izz" value="1.40" />

  <!-- ixy, ixz, iyz - центробежные моменты (не ограничены)-->
  <!-- 
    мера асимметрии распределения массы относительно осей координат:
    ixy = −∫ρ⋅xydV
    =0, при условии симметрии объекта
  -->

  <!-- каркас машины -->
  <link name="base_link">

    <!-- визуал -->
    <visual>
      <!-- координаты base_link -->
      <origin xyz="0 0 ${base_height / 2.0}" rpy="0.0 0.0 0.0"/>

      <!-- размерность каркаса -->
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <!-- материал и цвет -->
      <material name="base_blue">
        <color rgba="0.05 0.36 0.72 1.0"/>  
      </material>
    </visual>

    <!-- коллизии (bbox) -->
    <collision>
      <origin xyz="0 0 ${base_height / 2.0}" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <!-- инерция (физика объекта) -->
    <inertial>
      <!-- <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/> -->
      <mass value="${base_mass}"/>
      <inertia
        ixx="${base_ixx}"
        ixy="0.0"
        ixz="0.0"
        iyy="${base_iyy}"
        iyz="0.0"
        izz="${base_izz}"
      />
    </inertial>
  </link>

  <!-- lidar_link (лидар) params-->
  <xacro:property name="lidar_x" value="0.28" />
  <xacro:property name="lidar_y" value="0.0" />
  <!-- Z лидара считается ОТ НИЗА КУЗОВА (${base_height}) + нужный отступ -->
  <xacro:property name="lidar_z_rel" value="0.03" /> 

  <!-- lidar_link -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.06" length="0.1"/></geometry>
      <material name="lidar_red"><color rgba="1.0 0.0 0.0 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.06" length="0.1"/></geometry>       
    </collision>
    <inertial>
        <mass value="0.033"/>
        <inertia
          ixx="0.0003"
          ixy="0"
          ixz="0"
          iyy="0.0003"
          iyz="0"
          izz="0.0003"
        />
    </inertial>
  </link>

  <!-- base + lidar-->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- Прибавляем высоту кузова, чтобы считать от его верха -->
    <origin xyz="${lidar_x} ${lidar_y} ${base_height + lidar_z_rel}" rpy="0.0 0.0 0.0"/>
  </joint>

  <!-- imu_link (инерциальный измерительный модуль) params -->
  <xacro:property name="imu_x" value="0.28" />
  <xacro:property name="imu_y" value="-0.15" />
  <xacro:property name="imu_z_rel" value="0.01" />

  <!-- imu_link -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.05 0.05 0.02" /></geometry>
      <material name="imu_orange"><color rgba="1.0 0.5 0.0 1.0" /></material>
    </visual>
    <collision>
      <geometry><box size="0.05 0.05 0.02" /></geometry>
    </collision>
    <inertial>
      <mass value="0.033" />
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003" />
    </inertial>
  </link>

  <!-- base + imu -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="${imu_x} ${imu_y} ${base_height + imu_z_rel}" rpy="0 0 0" />
  </joint>

  <!-- camera_link params -->
  <xacro:property name="camera_x" value="0.28" />
  <xacro:property name="camera_y" value="0.15" />
  <xacro:property name="camera_z_rel" value="0.02" />

  <!-- camera_link -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.06 0.1 0.04" /></geometry>
      <material name="camera_green"><color rgba="0.0 1.0 0.0 1.0" /></material>
    </visual>
    <collision>
      <geometry><box size="0.06 0.1 0.04" /></geometry>
    </collision>
    <inertial>
      <mass value="0.033" />
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003" />
    </inertial>
  </link>

  <!-- base + camera -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <origin xyz="${camera_x} ${camera_y} ${base_height + camera_z_rel}" rpy="0 0 0" />
  </joint>

  <!-- wheel_link (колесо) params -->
  <xacro:property name="wheel_radius" value="0.12" />
  <xacro:property name="wheel_width" value="0.07" />
  <xacro:property name="wheel_mass" value="0.8" />
  <xacro:property name="wheel_ixx" value="0.006" />
  <xacro:property name="wheel_iyy" value="0.003" />
  <xacro:property name="wheel_izz" value="0.006" />

  <!-- wheel_macro -->
  <xacro:macro name="wheel" params="prefix parent x y z_offset">
    <link name="${prefix}_wheel">
      
      <!-- визуал -->
      <visual>
        <!-- Колесо лежит на боку, поэтому поворачиваем геометрию -->
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
        <material name="wheel_dark">
          <color rgba="0.1 0.1 0.1 1.0" />
        </material>
      </visual>

      <!-- коллизии (bbox) -->
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>

      <!-- инерция (физика объекта) -->
      <inertial>
        <mass value="${wheel_mass}" />
        <inertia ixx="${wheel_ixx}" ixy="0" ixz="0" iyy="${wheel_iyy}" iyz="0" izz="${wheel_izz}" />
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${parent}" />
      <child link="${prefix}_wheel" />
      <!-- Центр колеса на уровне земли (Z=0), низ уходит в землю на радиус -->
      <origin xyz="${x} ${y} ${z_offset}" rpy="0 0 0" />
      <!-- Ось вращения - ось Y локальной системы колеса -->
      <axis xyz="0 1 0" />
    </joint>
  </xacro:macro>


  fixed
  continuous
  revolute
  prismatic
  floating
  planar


  <!-- передние колеса (напрямую к base_link, без кулаков) -->
  <xacro:wheel prefix="front_left" parent="base_link" x="0.4" y="0.31" z_offset="0.0" />
  <xacro:wheel prefix="front_right" parent="base_link" x="0.4" y="-0.31" z_offset="0.0" />
  <!-- задние колеса (напрямую к base_link) -->
  <xacro:wheel prefix="rear_left" parent="base_link" x="-0.4" y="0.31" z_offset="0.0" />
  <xacro:wheel prefix="rear_right" parent="base_link" x="-0.4" y="-0.31" z_offset="0.0" />

</robot>